# Set in Vercel → Settings → Environment Variables, or a local .env
OPENAI_API_KEY=sk-...           # required — key for your chat provider
OPENAI_BASE_URL=               # optional — OpenAI-compatible base URL (default OpenAI). DeepSeek: https://api.deepseek.com
OPENAI_MODEL=                  # optional — chat model (default gpt-4o-mini). DeepSeek: deepseek-chat
USE_EMBEDDINGS=                # optional — set to 1 to use embeddings retrieval (needs an embeddings API, e.g. OpenAI).
                               #   Unset = lexical retrieval, works with any chat provider (e.g. DeepSeek).
